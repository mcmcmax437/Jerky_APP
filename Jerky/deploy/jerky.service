[Unit]
Description=Jerky storefront
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/src/Jerky_web/Jerky_APP/Jerky
Environment=NODE_ENV=production
EnvironmentFile=/usr/src/Jerky_web/Jerky_APP/Jerky/.env
KillMode=control-group
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port __PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
