[Unit]
Description=Jerky storefront
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/src/Jerky_web/Jerky_APP/Jerky
Environment=NODE_ENV=production
EnvironmentFile=/usr/src/Jerky_web/Jerky_APP/Jerky/.env
ExecStart=/usr/bin/env npm run start:prod
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
